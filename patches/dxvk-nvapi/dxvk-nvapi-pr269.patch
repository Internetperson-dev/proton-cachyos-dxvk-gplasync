     std::unordered_map<NvU32, NvU32> parsedrsdwordsettings(const std::string& str);
+
+    std::unordered_map<NvU32, NvU32> enrichwithenv(std::unordered_map<NvU32, NvU32> map, const char* prefix);
 }
