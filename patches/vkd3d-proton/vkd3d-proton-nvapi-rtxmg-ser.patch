From f053ba650ca7e03f53feee8a860692f43402dfeb Mon Sep 17 00:00:00 2001
From: Krzysztof Bogacki <krzysztof.bogacki@leancode.pl>
Date: Tue, 4 Feb 2025 02:28:50 +0100
Subject: [PATCH 01/39] vkd3d: Prepare for cubin 64bit support.

---
 libs/vkd3d/device.c        | 5 +++++
 libs/vkd3d/vkd3d_private.h | 2 ++
 libs/vkd3d/vulkan_procs.h  | 1 +
 3 files changed, 8 insertions(+)

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 84b90516..01351e37 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -237,6 +237,11 @@ static unsigned int vkd3d_check_extensions(const VkExtensionProperties *extensio
         }
     }
 
+    if (vulkan_info->NVX_binary_import && vulkan_info->NVX_image_view_handle &&
+            has_extension(extensions, count, VK_NVX_BINARY_IMPORT_EXTENSION_NAME, 2) &&
+            has_extension(extensions, count, VK_NVX_IMAGE_VIEW_HANDLE_EXTENSION_NAME, 3))
+        vulkan_info->supports_cubin_64bit = true;
+
     for (i = 0; i < user_extension_count; ++i)
     {
         if (!has_extension(extensions, count, user_extensions[i], 0))
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index a60bdbb6..000f5296 100644
--- a/libs/vkd3d/vkd3d_private.h
