From aeaf7123d5c3f85e62086a7374fd54db4f72e522 Mon Sep 17 00:00:00 2001
From: Krzysztof Bogacki <krzysztof.bogacki@leancode.pl>
Date: Thu, 18 May 2023 02:37:04 +0200
Subject: [PATCH 13/39] include: Introduce ID3D12DeviceExt3 interface.

Params are passed as void* to avoid depending on NVAPI header.

Signed-off-by: Krzysztof Bogacki <krzysztof.bogacki@leancode.pl>
---
 include/vkd3d_device_vkd3d_ext.idl | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/include/vkd3d_device_vkd3d_ext.idl b/include/vkd3d_device_vkd3d_ext.idl
index 05b28138..738ce6c4 100644
--- a/include/vkd3d_device_vkd3d_ext.idl
+++ b/include/vkd3d_device_vkd3d_ext.idl
@@ -110,3 +110,17 @@ interface ID3D12DeviceExt2 : ID3D12DeviceExt1
     HRESULT GetCudaMergedTextureSamplerObject(D3D12_GET_CUDA_MERGED_TEXTURE_SAMPLER_OBJECT_PARAMS *params);
     HRESULT GetCudaIndependentDescriptorObject(D3D12_GET_CUDA_INDEPENDENT_DESCRIPTOR_OBJECT_PARAMS *params);
 }
+
+[
+    uuid(e859c4ac-ba8f-41c4-8eac-1137fde6158e),
+    object,
+    local,
+    pointer_default(unique)
+]
+interface ID3D12DeviceExt3 : ID3D12DeviceExt2
+{
+    HRESULT SetCreatePipelineStateOptions(const void *params);
+    HRESULT CheckDriverMatchingIdentifierEx(void *params);
+    HRESULT GetRaytracingAccelerationStructurePrebuildInfoEx(void *params);
+    HRESULT GetRaytracingOpacityMicromapArrayPrebuildInfo(void *params);
+}
-- 
