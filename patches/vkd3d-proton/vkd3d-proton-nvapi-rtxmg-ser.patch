From 4110cd999d7c484781a04150bd4bd2b7b13000ed Mon Sep 17 00:00:00 2001
From: Krzysztof Bogacki <krzysztof.bogacki@leancode.pl>
Date: Fri, 23 May 2025 21:53:02 +0200
Subject: [PATCH 29/39] vkd3d: Implement
 ID3D12DeviceExt4_IsNvShaderExtnOpCodeSupported.

---
 libs/vkd3d/device_vkd3d_ext.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/libs/vkd3d/device_vkd3d_ext.c b/libs/vkd3d/device_vkd3d_ext.c
index 5e9b420b..86ecbe04 100644
--- a/libs/vkd3d/device_vkd3d_ext.c
+++ b/libs/vkd3d/device_vkd3d_ext.c
@@ -19,6 +19,7 @@
 #define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
 
 #include "vkd3d_private.h"
+#include "nvShaderExtnEnums.h"
 
 static inline struct d3d12_device *d3d12_device_from_ID3D12DeviceExt(d3d12_device_vkd3d_ext_iface *iface)
 {
@@ -641,6 +642,29 @@ cleanup:
     return ns;
 }
 
+static BOOL STDMETHODCALLTYPE d3d12_device_vkd3d_ext_IsNvShaderExtnOpCodeSupported(d3d12_device_vkd3d_ext_iface *iface,
+        UINT32 op_code)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DeviceExt(iface);
+
+    TRACE("iface %p, op_code %"PRIu32".\n", iface, op_code);
+
+    switch (op_code)
+    {
+        case NV_EXTN_OP_GET_SPECIAL:
+            /* Assume the caller is interested in NV_SPECIALOP_GLOBAL_TIMER_{LO,HI},
+             * as other subopcodes are only used together with other opcodes. */
+            return device->device_info.shader_clock_features.shaderDeviceClock ? TRUE : FALSE;
+        case NV_EXTN_OP_RT_GET_CLUSTER_ID:
+        case NV_EXTN_OP_RT_GET_CANDIDATE_CLUSTER_ID:
+        case NV_EXTN_OP_RT_GET_COMMITTED_CLUSTER_ID:
+            return device->device_info.cluster_acceleration_structure_features_nv.clusterAccelerationStructure
+                ? TRUE : FALSE;
+        default:
+            return FALSE;
+    }
+}
+
 CONST_VTBL struct ID3D12DeviceExt3Vtbl d3d12_device_vkd3d_ext_vtbl =
 {
     /* IUnknown methods */
